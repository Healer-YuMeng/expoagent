# General_ageng unified environment template
# Copy this file to `.env` in the project root, then fill in real values.

# =====================================================
# Backend / common
# =====================================================

# Database
POSTGRES_DB=General_ageng_admissions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password123
POSTGRES_HOST_PORT=5436
POSTGRES_URL=postgresql://postgres:password123@localhost:5436/General_ageng_admissions
POSTGRES_SSL=False
DB_NAME=General_ageng_admissions

# Docker images / deployment
SERVER_DOCKER_REGISTRY=youwei.tencentcloudcr.com
SERVER_DOCKER_NAMESPACE=General_ageng
BACKEND_IMAGE_NAME=General_ageng-backend
BACKEND_IMAGE_TAG=latest
FRONTEND_IMAGE_NAME=General_ageng-frontend
FRONTEND_IMAGE_TAG=latest
BACKEND_PULL_POLICY=always
FRONTEND_PULL_POLICY=always
BACKEND_HOST_PORT=9008
FRONTEND_HOST_PORT=8006
tiao=18080/visitor
MINIO_API_PORT=9002
MINIO_CONSOLE_PORT=9004

# Security
SECRET_KEY=replace-with-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# LLM (chat)
LLM_PROVIDER=qwen
LANGCHAIN_CHAT_MODEL=qwen-plus
LANGCHAIN_EXTRACTION_MODEL=qwen-plus
LANGCHAIN_CHAT_TEMPERATURE=0.2
LANGCHAIN_CHAT_SYSTEM_PROMPT=
OPENAI_API_KEY=
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings & knowledge base
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=text-embedding-v4
KNOWLEDGE_BASE_DIR=rag/data/knowledge_base
CHROMA_PERSIST_DIR=rag/data/chroma/vector_store
CHROMA_COLLECTION_NAME=General_ageng_kb
CHROMA_TOP_K=4
PARENT_CHUNK_SIZE=1200
PARENT_CHUNK_OVERLAP=120
CHILD_CHUNK_SIZE=320
CHILD_CHUNK_OVERLAP=40

# RAG document management
RAG_TMP_DIR=rag/data/tmp_uploads
RAG_BUCKET=fy-rag-docs
RAG_MINIO_ENDPOINT=127.0.0.1:9002
RAG_MINIO_ACCESS_KEY=minioadmin
RAG_MINIO_SECRET_KEY=minioadmin
RAG_MINIO_SECURE=False
RAG_BM25_CACHE=rag/data/rag/bm25_store.json
RAG_CHROMA_DIR=rag/data/rag/chroma
RAG_USE_ASYNC_DEFAULT=True
REDIS_HOST_PORT=6396
RAG_REDIS_URL=redis://127.0.0.1:6396/0
RAG_EMBED_MODEL=text-embedding-v4
RAG_IMAGE_OCR_MODEL=qwen3-vl-plus

# LangSmith (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=

# Backend service
BACKEND_HOST=127.0.0.1
BACKEND_PORT=9008

# CORS
CORS_ORIGINS=["http://101.35.111.34:8006","http://localhost:8006","http://127.0.0.1:8006"]
EXTRA_CORS_ORIGINS=

# WeCom integration
WECHAT_QR_BASE_URL=http://127.0.0.1:9008/static/wecom_qr
WECHAT_ADVISORS=[{"campus":"浦东","teacher_name":"Sophia Liu","wechat_id":"wxid_pudong_advisor","qr_image":"pudong.png","contact_phone":"13800001111"},{"campus":"浦西","teacher_name":"Daniel Chen","wechat_id":"wxid_puxi_advisor","qr_image":"puxi.png","contact_phone":"13800002222"},{"campus":"临港","teacher_name":"Emily Zhang","wechat_id":"wxid_lingang_advisor","qr_image":"lingang.png","contact_phone":"13800003333"}]
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_RECEIVE_ID=

# SMTP (optional)
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=招生办

# Business
DEBUG=True
LOG_LEVEL=INFO
INTENT_SCORE_THRESHOLD=60
AUTO_ARCHIVE_DAYS=90
FOLLOW_UP_REMINDER_DAYS=3

# =====================================================
# CF Agent / cfapi
# =====================================================

CF_AGENT_BASE_URL=https://qw-openapi-tx.dustess.com
CF_AGENT_CLIENT_ID=
CF_AGENT_CLIENT_SECRET=
CF_AGENT_CALLBACK_TOKEN=
CF_AGENT_ENCODING_AES_KEY=
CF_AGENT_RECEIVE_ID=
CF_AGENT_SCRM_ACCOUNT_ID=
CF_AGENT_USER_ID=
CF_AGENT_TEST_CHAT_ID=
CF_AGENT_TEST_QW_USER_ID=
CF_AGENT_TEST_TARGET_IDS=["external-user-id-1"]
